*.bak
*.bak-*
.bak-*
.backups/
.mcp.json.local-bak

# Web UI: dependencies and build output, and the export staged for //go:embed
# (.gitkeep keeps the directive compiling on a checkout with no UI built).
/ui/node_modules/
/ui/.next/
/ui/out/
/internal/webui/web/*
!/internal/webui/web/.gitkeep
